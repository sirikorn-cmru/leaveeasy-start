// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
//
// 📌 ไฟล์นี้เก็บไว้ให้กฎอยู่ในประวัติ git ตรวจย้อนหลังได้
//    แต่ Firestore ยังไม่ได้อ่านจากไฟล์นี้โดยตรง
//    ต้องคัดลอกไปวางใน Firebase Console → Firestore Database → Rules
//    แล้วกด Publish ทุกครั้งที่แก้
//
// สัปดาห์ที่ 7 — กฎขั้นต่ำ "ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้"
// สัปดาห์ที่ 8 — จะเปลี่ยนเป็นกฎรายโฟลเดอร์ตามตารางใน ACL.md
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // {document=**} = ทุกไฟล์ในทุกโฟลเดอร์ "รวมโฟลเดอร์ย่อย approvals" ด้วย
    // request.auth != null = คนที่ล็อกอินอยู่เท่านั้น
    //
    // ⚠️ สัปดาห์นี้ยังไม่แยกตามบทบาท — ล็อกอินแล้วทำได้ทุกอย่าง
    //    การกันตามบทบาทตาม ACL.md เป็นงานของสัปดาห์ที่ 8
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
